DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
# Optional. The On the Road agent calls Mistral when this is set.
# Without it, To decide still shows the decision read from the records.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# --- LIVE PICKUP CALL (optional; see lib/agent/phone-live.ts) ----------------
# Unset => the pickup "Call the pickup place" runs the deterministic mock.
# Set all four => the route can place a REAL Twilio call (Mode A, scripted IVR).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# CALL_CENTER_FROM=            # the call-centre number in E.164, e.g. +358XXXXXXXXX
# PUBLIC_BASE_URL=             # public URL Twilio can reach for webhooks
#
# Conversational voice agent (Mode B) — only if you need free back-and-forth.
# VOICE_PROVIDER=              # vapi | bland | retell | self (unset => Mode A)
# VAPI_API_KEY=
